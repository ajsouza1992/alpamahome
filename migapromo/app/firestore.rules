rules_version = '2';

// Regras do Firestore — Miga Promo
// Cole em: Firebase → Firestore Database → Regras → Publicar.
// Só as contas Google da lista abaixo entram, e cada uma só lê e grava a própria pasta "usuarios/{uid}".
// TROQUE o e-mail de exemplo pelo e-mail Google autorizado (em letras minúsculas).
// Para liberar mais contas depois, acrescente outros e-mails na lista, separados por vírgula.
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizada() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'sua-conta@gmail.com'
        ];
    }

    // Espaço único da Miga: todas as contas autorizadas usam os mesmos dados
    match /espacos/miga/{documento=**} {
      allow read, write: if autorizada();
    }

    // Site público (vitrine): qualquer pessoa LÊ só os produtos que você pôs no site (nome, foto, preço, cupom, loja, link, descrição)
    // e os links do canal/grupo. Só as contas autorizadas gravam. A lista, o histórico e os ajustes continuam fechados.
    match /vitrine/miga/{documento=**} {
      allow read: if true;
      allow write: if autorizada();
    }

    // Contador de acessos do site: qualquer visitante só CRIA um registro pequeno (o tipo do toque, o produto, de onde veio e quando).
    // Ninguém de fora lê. Só as contas autorizadas leem e apagam.
    match /acessos/miga/eventos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'produto', 'nome', 'loja', 'origem', 'disp', 'em'])
        && request.resource.data.tipo in ['visita', 'abrir', 'loja', 'cupom', 'compartilhar', 'whatsapp', 'instagram', 'tiktok']
        && request.resource.data.produto is string && request.resource.data.produto.size() <= 80
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 140
        && request.resource.data.loja is string && request.resource.data.loja.size() <= 20
        && request.resource.data.origem is string && request.resource.data.origem.size() <= 20
        && request.resource.data.disp is string && request.resource.data.disp.size() <= 20
        && request.resource.data.em is timestamp;
      allow read, delete: if autorizada();
    }

    // Pasta antiga de cada conta (só para o app levar os dados para o espaço único)
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if autorizada() && request.auth.uid == uid;
    }

    // Todo o resto fica fechado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
