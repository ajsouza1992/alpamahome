{
  "manifest_version": 3,
  "name": "Miga Promo · Achadinhos",
  "version": "1.5.0",
  "description": "Marque produtos no Mercado Livre e na Shopee e mande todos de uma vez para a Caixa de importação da Miga Promo.",
  "icons": { "16": "icone-16.png", "48": "icone-48.png", "128": "icone-128.png" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://mercadolivre.com.br/*",
        "https://shopee.com.br/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
