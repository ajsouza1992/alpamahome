rules_version = '2';

// Regras do Firestore — Miga Promo
// Cole em: Firebase → Firestore Database → Regras → Publicar.
// Só as contas Google da lista abaixo entram, e cada uma só lê e grava a própria pasta "usuarios/{uid}".
// TROQUE o e-mail de exemplo pelo e-mail Google autorizado (em letras minúsculas).
// Para liberar mais contas depois, acrescente outros e-mails na lista, separados por vírgula.
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizada() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'sua-conta@gmail.com'
        ];
    }

    match /usuarios/{uid}/{documento=**} {
      allow read, write: if autorizada() && request.auth.uid == uid;
    }

    // Todo o resto fica fechado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
