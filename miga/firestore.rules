rules_version = '2';

// Regras do Firestore — Miga Promo
// Cole em: Firebase → Firestore Database → Regras → Publicar.
// Cada usuária (login anônimo) só lê e grava a própria pasta "usuarios/{uid}".
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo o resto fica fechado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
